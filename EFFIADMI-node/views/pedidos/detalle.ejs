<section class="pagina-modulo">
    <div class="cabecera-modulo">
        <h1>Pedido PED-<%= pedido.numero %></h1>
        <a href="/pedidos" class="btn btn-outline">Volver</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="detalle-grid">
                <div>
                    <p><strong>Cliente:</strong> <%= pedido.cliente ? pedido.cliente.nombre : '-' %></p>
                    <p><strong>Correo:</strong> <%= pedido.cliente ? pedido.cliente.correo : '-' %></p>
                    <p><strong>Teléfono:</strong> <%= pedido.cliente ? pedido.cliente.telefono : '-' %></p>
                </div>
                <div>
                    <p><strong>Fecha:</strong> <%= fmtFecha(pedido.createdAt) %></p>
                    <p><strong>Usuario:</strong> <%= pedido.usuario ? (pedido.usuario.username || pedido.usuario.nombre) : 'Sistema' %></p>
                    <p><strong>Estado:</strong>
                        <% if (pedido.estado === 'pendiente') { %>
                            <span class="estado-pedido pendiente">Pendiente</span>
                        <% } else if (pedido.estado === 'confirmado') { %>
                            <span class="estado-pedido confirmado">Confirmado</span>
                        <% } else if (pedido.estado === 'pagado') { %>
                            <span class="estado-pedido pagado">Pagado</span>
                        <% } else { %>
                            <span class="estado-pedido cancelado">Cancelado</span>
                        <% } %>
                    </p>
                </div>
            </div>

            <div class="detalle-productos">
                <h3>Productos</h3>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% detalles.forEach(function(det) { %>
                            <tr>
                                <td><%= det.producto ? det.producto.nombre : 'Producto eliminado' %></td>
                                <td><%= det.cantidad %></td>
                                <td><%= cop(det.precio_unitario) %></td>
                                <td><%= cop(det.subtotal) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                <div class="detalle-total">
                    <span class="label-total">Total:</span>
                    <strong class="total-pedido-valor"><%= cop(pedido.total) %></strong>
                </div>
            </div>

            <% if (facturaAsociada) { %>
                <div class="card-nota-factura">
                    <span class="material-symbols-outlined">check_circle</span>
                    <span>Factura #<%= facturaAsociada.numero %> generada - <%= facturaAsociada.estado === 'emitida' ? 'Emitida' : 'Anulada' %></span>
                </div>
            <% } %>
        </div>

        <div class="card-footer">
            <% if (pedido.estado === 'pendiente') { %>
                <form method="POST" action="/pedidos/<%= pedido._id %>/confirmar" class="inline-form"
                      onsubmit="return confirm('Confirmar este pedido? Se descontará el inventario.');">
                    <button type="submit" class="btn btn-primary">Confirmar Pedido</button>
                </form>
                <form method="POST" action="/pedidos/<%= pedido._id %>/cancelar" class="inline-form"
                      onsubmit="return confirm('Cancelar este pedido?');">
                    <button type="submit" class="btn btn-outline btn-danger-text">Cancelar Pedido</button>
                </form>
            <% } else if (pedido.estado === 'confirmado') { %>
                <form method="POST" action="/pedidos/<%= pedido._id %>/pagar" class="inline-form"
                      onsubmit="return confirm('Marcar como pagado? Se generará la factura.');">
                    <button type="submit" class="btn btn-primary">Marcar como Pagado</button>
                </form>
                <form method="POST" action="/pedidos/<%= pedido._id %>/cancelar" class="inline-form"
                      onsubmit="return confirm('Cancelar este pedido?');">
                    <button type="submit" class="btn btn-outline btn-danger-text">Cancelar Pedido</button>
                </form>
            <% } %>
        </div>
    </div>
</section>