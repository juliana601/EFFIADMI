<section class="pagina-modulo">
    <div class="cabecera-modulo">
        <h1>Nuevo Usuario</h1>
        <a href="/usuarios" class="btn btn-outline">Volver</a>
    </div>

    <div class="card">
        <form method="POST" action="/usuarios/crear" autocomplete="off">
            <div class="card-body">
                <div class="form-group">
                    <label for="nombre" class="form-label">Nombre</label>
                    <input type="text" id="nombre" name="nombre" class="form-control" required>
                </div>

                <div class="form-group">
                    <label for="apellido" class="form-label">Apellido</label>
                    <input type="text" id="apellido" name="apellido" class="form-control" required>
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <input type="email" id="email" name="email" class="form-control" required>
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">Contraseña</label>
                    <input type="password" id="password" name="password" class="form-control"
                           autocomplete="new-password" required>
                </div>

                <div class="form-group">
                    <label for="rol" class="form-label">Cargo</label>
                    <select id="rol" name="rol" class="form-control" required>
                        <option value="">Selecciona un cargo</option>
                        <option value="admin">Administrador</option>
                        <option value="operador" selected>Operador</option>
                    </select>
                </div>
            </div>

            <div class="card-footer">
                <a href="/usuarios" class="btn btn-outline">Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</section>