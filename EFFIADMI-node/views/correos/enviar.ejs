<div class="page-header">
    <div class="page-header-title">
        <h1>Enviar correo</h1>
        <p>Registra y envía un mensaje de correo</p>
    </div>
</div>

<section class="card">
    <div class="card-body">
        <form method="POST" action="/correos/enviar" class="form-grid">
            <div class="form-group">
                <label for="para">Para (correo)</label>
                <input type="email" id="para" name="para" required placeholder="destinatario@correo.com">
            </div>
            <div class="form-group">
                <label for="asunto">Asunto</label>
                <input type="text" id="asunto" name="asunto" required placeholder="Asunto del correo">
            </div>
            <div class="form-group form-group-full">
                <label for="cuerpo">Cuerpo del mensaje</label>
                <textarea id="cuerpo" name="cuerpo" rows="8" required placeholder="Escribe el contenido del correo..."></textarea>
            </div>
            <div class="form-actions form-group-full">
                <a href="/correos" class="btn btn-outline">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">send</span> Enviar
                </button>
            </div>
        </form>
    </div>
</section>
