<section class="pagina-modulo">
    <div class="cabecera-modulo">
        <h1><%= inventario.product.nombre %></h1>
        <a href="/inventario" class="btn btn-outline">Volver</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="detalle-grid">
                <div class="form-group">
                    <label class="form-label">ID</label>
                    <p><%= inventario.product.sku %></p>
                </div>
                <div class="form-group">
                    <label class="form-label">Sucursal</label>
                    <p><%= inventario.branch.nombre %></p>
                </div>
                <div class="form-group">
                    <label class="form-label">Categoría</label>
                    <p><%= inventario.product.categoria ? inventario.product.categoria.nombre : '-' %></p>
                </div>
                <div class="form-group">
                    <label class="form-label">Stock Disponible</label>
                    <p>
                        <% if (inventario.cantidad_disponible <= inventario.stock_minimo) { %>
                            <span class="stock-bajo"><%= inventario.cantidad_disponible %></span>
                            <span class="stock-bajo">(Bajo mínimo)</span>
                        <% } else { %>
                            <%= inventario.cantidad_disponible %>
                        <% } %>
                    </p>
                </div>
                <div class="form-group">
                    <label class="form-label">Stock Mínimo</label>
                    <p><%= inventario.stock_minimo %></p>
                </div>
                <div class="form-group">
                    <label class="form-label">Precio Venta</label>
                    <p><%= cop(inventario.product.precio_venta) %></p>
                </div>
                <div class="form-group">
                    <label class="form-label">Descripción</label>
                    <p><%= inventario.product.descripcion || '-' %></p>
                </div>
                <div class="form-group">
                    <label class="form-label">Fecha Creación</label>
                    <p><%= fmtFecha(inventario.createdAt) %></p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2>Movimientos Recientes</h2>
            <a href="/inventario/<%= inventario._id %>/movimiento" class="btn btn-primary btn-sm">+ Nuevo Movimiento</a>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Resultante</th>
                        <th>Motivo</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    <% movimientos.forEach(function(mov) { %>
                        <tr>
                            <td><%= fmtFecha(mov.fecha || mov.createdAt) %></td>
                            <td>
                                <% if (mov.tipo_movimiento === 'ENTRADA') { %>
                                    <span class="tipo-mov entradas">Entrada</span>
                                <% } else if (mov.tipo_movimiento === 'SALIDA') { %>
                                    <span class="tipo-mov salida">Salida</span>
                                <% } else { %>
                                    <span class="tipo-mov ajuste">Ajuste</span>
                                <% } %>
                            </td>
                            <td><%= mov.cantidad %></td>
                            <td><%= mov.cantidad_resultante %></td>
                            <td><%= mov.motivo || '-' %></td>
                            <td><%= mov.usuario ? (mov.usuario.username || mov.usuario.nombre) : 'Sistema' %></td>
                        </tr>
                    <% }); %>
                    <% if (movimientos.length === 0) { %>
                        <tr>
                            <td colspan="6" class="tabla-vacia">No hay movimientos registrados.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</section>