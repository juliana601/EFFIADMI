<section class="perfil-page">
    <h1>Mi perfil</h1>

    <form method="post" action="/auth/perfil" class="perfil-form">
        <div class="form-group">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" name="nombre" id="nombre" class="form-control"
                   value="<%= usuario.nombre %>">
        </div>

        <div class="form-group">
            <label for="apellido" class="form-label">Apellido</label>
            <input type="text" name="apellido" id="apellido" class="form-control"
                   value="<%= usuario.apellido %>">
        </div>

        <div class="form-group">
            <label for="email" class="form-label">Correo electrónico</label>
            <input type="email" name="email" id="email" class="form-control"
                   value="<%= usuario.email %>" required>
        </div>

        <div class="form-group">
            <label for="telefono" class="form-label">Teléfono</label>
            <input type="text" name="telefono" id="telefono" class="form-control"
                   value="<%= usuario.telefono %>">
        </div>

        <div class="form-group">
            <label for="direccion" class="form-label">Dirección</label>
            <input type="text" name="direccion" id="direccion" class="form-control"
                   value="<%= usuario.direccion %>">
        </div>

        <div class="form-group">
            <label for="password" class="form-label">Nueva contraseña (opcional)</label>
            <input type="password" name="password" id="password" class="form-control"
                   placeholder="Déjala vacía para no cambiarla">
        </div>

        <p class="rol-actual">Rol: <span class="badge-rol <%= usuario.rol %>"><%= usuario.rol %></span></p>

        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a href="/auth/dashboard" class="btn btn-outline">Volver</a>
    </form>
</section>