# Variables de entorno de EFFIADMI
# Copia este archivo como .env y define los valores correspondientes

# Puerto en el que se ejecuta el servidor
PORT=3000

# URI de conexion a MongoDB (se usa MONGO_URI como respaldo)
MONGODB_URI=mongodb://127.0.0.1:27017/effiadmi
MONGO_URI=

# Secreto para las sesiones de Express
SESSION_SECRET=cambia_esta_clave_secreta

# Respaldo automatico (node-cron) - formato cron de 6 campos
BACKUP_CRON=0 0 0 * * *
BACKUP_DIR=./backup
