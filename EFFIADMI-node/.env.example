# Variables de entorno de EFFIADMI
# Copia este archivo como .env y define los valores correspondientes

# Puerto en el que se ejecuta el servidor
PORT=3000

# URI de conexion a MongoDB (se usa MONGO_URI como respaldo)
MONGODB_URI=mongodb://127.0.0.1:27017/effiadmi
MONGO_URI=

# Secreto para las sesiones de Express
SESSION_SECRET=cambia_esta_clave_secreta

# Respaldo automatico (node-cron) - formato cron de 6 campos
BACKUP_CRON=0 0 0 * * *
BACKUP_DIR=./backup

# Notificacion de respaldo por correo (SMTP Gmail)
# En Gmail se usa una contrasena de aplicacion (no la clave normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contrasena_de_aplicacion
SMTP_FROM_NOMBRE=EFFIADMI

# Destinatarios de notificacion de backup (separados por coma)
BACKUP_EMAIL_TO=tu_correo@gmail.com

# Base de datos que se respalda (por defecto la local)
BACKUP_MONGO_URI=mongodb://127.0.0.1:27017/effiadmi
